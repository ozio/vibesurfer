{
  "name": "vibesurfer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "npm ci --prefix generation-worker --ignore-scripts",
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "npm run worker:build && tsc -b && vite build && node scripts/verify-frame-shell.mjs",
    "build:desktop": "npm run desktop:build",
    "desktop:build": "npm run worker:sidecar && npm run worker:sidecar:smoke && tauri build --config src-tauri/tauri.bundle.conf.json",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "node --no-experimental-webstorage ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node --no-experimental-webstorage ./node_modules/vitest/vitest.mjs",
    "typecheck": "tsc -b --pretty false",
    "worker:install": "npm ci --prefix generation-worker --ignore-scripts",
    "worker:build": "npm run build --prefix generation-worker",
    "worker:verify": "npm run verify --prefix generation-worker",
    "worker:sidecar": "npm run sidecar:build --prefix generation-worker",
    "worker:smoke": "node scripts/smoke-worker.mjs --dist",
    "worker:sidecar:smoke": "node scripts/smoke-worker.mjs --sidecar",
    "verify": "npm run typecheck && npm test && npm run worker:verify && npm run worker:smoke && cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri"
  },
  "dependencies": {
    "@dnd-kit/dom": "0.5.0",
    "@dnd-kit/helpers": "0.5.0",
    "@dnd-kit/react": "0.5.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "radix-ui": "^1.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "4.1.10"
  }
}
