{
  "name": "vibesurfer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "npm ci --prefix generation-worker --ignore-scripts",
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "npm run kokoro:assets && npm run notices:check && npm run worker:build && tsc -b && vite build && node scripts/verify-frame-shell.mjs",
    "build:desktop": "npm run desktop:build",
    "desktop:build": "npm run worker:sidecar && npm run worker:sidecar:smoke && tauri build --config src-tauri/tauri.bundle.conf.json",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "notices:generate": "node scripts/generate-third-party-notices.mjs",
    "notices:check": "node scripts/generate-third-party-notices.mjs --check",
    "kokoro:assets": "node scripts/fetch-kokoro-assets.mjs",
    "test": "node --no-experimental-webstorage ./node_modules/vitest/vitest.mjs run --project=unit",
    "test:watch": "node --no-experimental-webstorage ./node_modules/vitest/vitest.mjs --project=unit",
    "test-storybook": "node --no-experimental-webstorage ./node_modules/vitest/vitest.mjs run --project=storybook",
    "typecheck": "tsc -b --pretty false",
    "worker:install": "npm ci --prefix generation-worker --ignore-scripts",
    "worker:build": "npm run build --prefix generation-worker",
    "worker:verify": "npm run verify --prefix generation-worker",
    "worker:sidecar": "npm run sidecar:build --prefix generation-worker",
    "worker:smoke": "node scripts/smoke-worker.mjs --dist",
    "worker:sidecar:smoke": "node scripts/smoke-worker.mjs --sidecar",
    "verify": "npm run notices:check && npm run typecheck && npm test && npm run test-storybook && npm run worker:verify && npm run worker:smoke && cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri",
    "storybook": "storybook dev --host 127.0.0.1 -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@dnd-kit/dom": "0.5.0",
    "@dnd-kit/helpers": "0.5.0",
    "@dnd-kit/react": "0.5.0",
    "@fontsource-variable/arimo": "5.3.0",
    "@fontsource-variable/gelasio": "5.3.0",
    "@fontsource-variable/noto-sans": "5.3.0",
    "@fontsource-variable/noto-sans-arabic": "5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "5.3.0",
    "@fontsource-variable/noto-sans-hebrew": "5.3.0",
    "@fontsource-variable/noto-sans-mono": "5.3.0",
    "@fontsource-variable/noto-sans-thai": "5.3.0",
    "@fontsource-variable/noto-serif": "5.3.0",
    "@fontsource-variable/roboto-condensed": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.0",
    "@fontsource/anton": "5.3.0",
    "@fontsource/archivo-black": "5.3.0",
    "@fontsource/comic-neue": "5.3.0",
    "@fontsource/cousine": "5.3.0",
    "@fontsource/noto-sans-jp": "5.3.0",
    "@fontsource/noto-sans-kr": "5.3.0",
    "@fontsource/noto-sans-sc": "5.3.0",
    "@fontsource/noto-sans-tc": "5.3.0",
    "@fontsource/tinos": "5.3.0",
    "@huggingface/transformers": "3.8.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "kokoro-js": "1.2.1",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "radix-ui": "^1.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/addon-vitest": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser-playwright": "4.1.10",
    "jsdom": "30.0.1",
    "playwright": "1.62.1",
    "postcss": "8.5.26",
    "storybook": "10.5.10",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "4.1.10"
  }
}
